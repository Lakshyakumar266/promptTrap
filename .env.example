# Local Gemma runtime (Ollama)
MODEL_BASE_URL=http://localhost:11434
MODEL_NAME=gemma:2b

# Optional: Mistral AI (Official Cloud API or Local Mistral)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Optional: Google AI Studio API key (for hosted Gemma / Gemini if tested via Google GenAI)
GEMINI_API_KEY=

# Optional: Browserbase credentials (for partner remote browser evaluation)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# PromptTrap Application Configuration
PORT=4000
ALLOWED_MOCK_ORIGIN=http://127.0.0.1:4000
MAX_ACTIONS_PER_RUN=10
RUN_TIMEOUT_SECONDS=60
