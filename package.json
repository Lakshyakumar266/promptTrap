{
  "name": "prompttrap",
  "version": "1.0.0",
  "description": "Local-first reproducible test harness evaluating browser agents against indirect prompt injection",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/api/server.ts",
    "dev": "tsx watch src/api/server.ts",
    "trap": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ai-agent",
    "prompt-injection",
    "security-evaluation",
    "gemma",
    "browserbase",
    "hacktoberfest"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsdom": "^26.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
